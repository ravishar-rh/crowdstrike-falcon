# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Variable files may contain the Falcon client ID/secret when
# manage_secret_value = true. The .example file is tracked.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terraform may write sensitive values here
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Local backend config. Names a real S3 state bucket, which is
# infrastructure detail that does not belong in a public repo -- CI passes
# the same values via repository variables instead.
backend.hcl
*.backend.hcl
backend.tfbackend
*.tfbackend

# Local credential scratch
*.pem
*.key
.env
.envrc

# macOS / editors
.DS_Store
*.swp
.idea/
.vscode/
