# Copy to terraform.tfvars for local runs. terraform.tfvars is gitignored.
#
# In GitHub Actions these come from repository variables instead -- see
# .github/workflows/terraform.yml. Nothing here is secret: the Falcon client
# ID and secret are typed into the AWS console by hand and never pass
# through Terraform.

aws_region  = "eu-west-1"
secret_name = "crowdstrike/falcon/api-credentials"

# The IAM role your existing External Secrets Operator assumes. Terraform
# grants it read access through the secret's resource policy and does not
# modify the role itself.
#
#   oc get clustersecretstore aws-secrets-manager \
#     -o jsonpath='{.spec.provider.aws.role}{"\n"}'
#
# Leave empty only if that role already has GetSecretValue on a prefix
# covering secret_name above -- and note create_kms_key must then be false,
# because a CMK needs an explicit grant.
eso_role_arns = ["arn:aws:iam::CHANGEME:role/CHANGEME-external-secrets"]

create_kms_key = true

# Only for a DR hub in another region.
# replica_regions = ["eu-central-1"]

tags = {
  ManagedBy   = "terraform"
  Component   = "crowdstrike-falcon"
  Owner       = "platform-security"
  Environment = "shared"
}
